+/** Find a La Pitaya agent by a hive-spawned agent id, which carries a random
+ *  suffix (e.g. `valentin-munh7sdc`). Matches the exact preset id too. */
+export function agentByHiveId(hiveId: string | null | undefined): LaPitayaAgent | undefined {
+  const q = toAscii(hiveId?.trim() ?? '').toLowerCase();
+  if (!q) return undefined;
+  return LA_PITAYA_AGENTS.find((a) => q === a.id || q.startsWith(a.id + '-'));
+}
